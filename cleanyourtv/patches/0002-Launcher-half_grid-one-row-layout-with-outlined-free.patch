+    // ---- half_grid row maths (local change). Without half_grid every row is COLUMNS long, as before. ----
+
+    /** First position of the row that holds p. */
+    private int rowStart(int p) {
+        if (!halfGrid || p < COLUMNS) return (p / COLUMNS) * COLUMNS;
+        return COLUMNS + ((p - COLUMNS) / (2 * COLUMNS)) * (2 * COLUMNS);
+    }
+
+    /** The position straight above p; negative from the first row. A half tile's dock tile is the one over it. */
+    private int above(int p) {
+        if (!halfGrid) return p - COLUMNS;
+        if (p < COLUMNS) return -1;
+        int g = p - COLUMNS;
+        return g < 2 * COLUMNS ? g / 2 : p - 2 * COLUMNS;
+    }
+
+    /** The position straight below p (it may be past the last tile). A dock tile has the left one of its two below. */
+    private int below(int p) {
+        if (!halfGrid) return p + COLUMNS;
+        return p < COLUMNS ? COLUMNS + 2 * p : p + 2 * COLUMNS;
+    }
+
+    /** The dock column above p, for Down from the top bar. */
+    private int dockColumn(int p) {
+        if (!halfGrid || p < COLUMNS) return p % COLUMNS;
+        return ((p - COLUMNS) % (2 * COLUMNS)) / 2;
     }
 
