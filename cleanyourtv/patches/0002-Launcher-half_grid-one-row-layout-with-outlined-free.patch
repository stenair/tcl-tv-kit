--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/HalfGridSlots.java
@@ -0,0 +1,60 @@
+package com.gathin.tvhome;
+
+import android.graphics.Canvas;
+import android.graphics.DashPathEffect;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.RecyclerView;
+
+/**
+ * Local change (TCL 75C755 setup), half_grid: a faint dashed outline in each free slot of the last half-size row, so
+ * the row reads as evenly spread and shows there is room for another app. Only drawn: it is no tile and takes no
+ * focus, so navigation and the saved order never see it. A full last row draws nothing.
+ */
+final class HalfGridSlots extends RecyclerView.ItemDecoration {
+    private final int dockSize, rowLength;
+    private final boolean rtl;
+    private final float density;
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+
+    HalfGridSlots(int dockSize, boolean rtl, float density) {
+        this.dockSize = dockSize;
+        this.rowLength = 2 * dockSize;
+        this.rtl = rtl;
+        this.density = density;
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(1.5f * density);
+        paint.setColor(0x4DFFFFFF);   // white at 30%
+        paint.setPathEffect(new DashPathEffect(new float[] {6 * density, 5 * density}, 0));
+    }
+
+    @Override
+    public void onDraw(@NonNull Canvas c, @NonNull RecyclerView parent, @NonNull RecyclerView.State state) {
+        if (!(parent.getAdapter() instanceof AppAdapter)) return;
+        int count = ((AppAdapter) parent.getAdapter()).appCount();
+        if (count <= dockSize) return;
+        int used = (count - dockSize) % rowLength;
+        if (used == 0) return;
+        // The last tile places the outlines: the same size, one grid cell further on for each free slot.
+        View last = null;
+        for (int i = 0; i < parent.getChildCount() && last == null; i++) {
+            View child = parent.getChildAt(i);
+            if (parent.getChildAdapterPosition(child) == count - 1) last = child;
+        }
+        View card = last == null ? null : last.findViewById(R.id.card);
+        if (card == null) return;   // the last row is scrolled off: nothing to line up with
+        float step = (parent.getWidth() - parent.getPaddingLeft() - parent.getPaddingRight()) / (float) rowLength;
+        if (rtl) step = -step;
+        float left = last.getLeft() + card.getLeft(), top = last.getTop() + card.getTop();
+        float radius = AppAdapter.cornerRadius(card.getWidth(), density), inset = paint.getStrokeWidth() / 2;
+        for (int k = 1; k <= rowLength - used; k++) {
+            float x = left + k * step;
+            rect.set(x + inset, top + inset, x + card.getWidth() - inset, top + card.getHeight() - inset);
+            c.drawRoundRect(rect, radius, radius, paint);
+        }
+    }
+}
