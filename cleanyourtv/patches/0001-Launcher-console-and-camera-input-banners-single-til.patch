From d5214b91c629fad5089a0967c56df182507751a7 Mon Sep 17 00:00:00 2001
From: Stefan Nair <stefan.nair97@gmail.com>
Date: Thu, 5 Nov 2026 18:11:50 +0800
Subject: [PATCH 1/2] Launcher: console and camera input banners, single-tile
 Move (local TCL 75C755 setup)

Local changes for one TV, not for upstream:
- banner_console and banner_cameras: plain controller and video-camera
  banners for input tiles mapped with app_banners (PS5 on HDMI 4,
  camera system on HDMI 2). Solid fills to stay under the APK size gate.
- A Move chosen from a tile's hold-OK menu now ends once the tile is
  placed (OK or Back), with its own hint. Reorder apps from the Settings
  menu keeps moving many tiles until Back again.

APK 589,793 bytes (gate 589,824); testReleaseUnitTest: 314 passed.
Tested on the TV: both banners show, the tile menu opens again after a
single Move.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../main/java/com/gathin/tvhome/MainActivity.java   | 13 +++++++++++--
 .../app/src/main/res/drawable/banner_cameras.xml    | 12 ++++++++++++
 .../app/src/main/res/drawable/banner_console.xml    | 12 ++++++++++++
 launcher/app/src/main/res/values/strings.xml        |  2 ++
 4 files changed, 37 insertions(+), 2 deletions(-)
 create mode 100644 launcher/app/src/main/res/drawable/banner_cameras.xml
 create mode 100644 launcher/app/src/main/res/drawable/banner_console.xml

diff --git a/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java b/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
index 870ca516..d22503d7 100644
--- a/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
+++ b/launcher/app/src/main/java/com/gathin/tvhome/MainActivity.java
@@ -330,6 +330,9 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
     private PopupWindow openPopup;
     /** Reorder mode is on (top-bar button). */
     private boolean reordering;
+    // Local change (TCL 75C755 setup): a Move chosen from a tile's menu moves that one tile, so placing it (OK or
+    // Back) ends the mode. Reorder apps from the Settings menu still moves many tiles until Back again.
+    private boolean singleMove;
     /** Key of the tile being carried in reorder mode, or null. */
     private String movingKey;
     /** Tile order when reorder mode started, to save only when something moved. */
@@ -1625,10 +1628,14 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
         dimOthers();
     }
 
-    /** Puts the carried tile down where it is; the mode stays on. */
+    /** Puts the carried tile down where it is; the mode stays on, unless it was a single Move from the tile menu. */
     private void drop() {
         movingKey = null;
         dimOthers();
+        if (singleMove) {
+            singleMove = false;   // cleared first: endReorder() calls drop() again
+            endReorder();
+        }
     }
 
     /** While a tile is carried, every other tile is dimmed so the carried one stands out; otherwise all are full. */
@@ -1651,6 +1658,7 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
     /** Ends the mode and saves the order if it changed since the mode started. */
     private void endReorder() {
         if (!reordering) return;
+        singleMove = false;
         dockEditing = false;
         dockEditSlot = -1;
         dockEditAppKey = null;
@@ -3833,7 +3841,8 @@ public class MainActivity extends Activity implements AppAdapter.TileListener {
             if (at < 0) return;
             focusTile(at);
             pickUp(at);
-            Toast.makeText(this, R.string.reorder_hint, Toast.LENGTH_LONG).show();
+            singleMove = true;
+            Toast.makeText(this, R.string.move_one_hint, Toast.LENGTH_LONG).show();
         });
         if (appLibraryEnabled) addSettingsMenuRow(rows, popup, R.string.library_remove_shortcut, () -> {
             if (LibraryApps.save(this, pkg, false)) reloadApps(false);
