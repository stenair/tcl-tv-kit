<?xml version="1.0" encoding="utf-8"?>
<!-- One camera on the setup screen: its label ("Camera 2 name (blue)"), its name field and a Try button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/camera_row_label"
        style="@style/CameraLabel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/camera_row_name"
            style="@style/CameraField"
            android:layout_width="0dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:inputType="textCapWords" />

        <Button
            android:id="@+id/camera_row_try"
            style="@style/CameraButton"
            android:layout_marginEnd="0dp"
            android:text="@string/camera_try" />
    </LinearLayout>
</LinearLayout>
