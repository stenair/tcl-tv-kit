<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, full-screen, no action bar: the camera setup screen. -->
    <style name="CameraSetupTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#FF0A84FF</item>
    </style>

    <style name="CameraLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CameraField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/camera_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:imeOptions">actionDone|flagNoExtractUi</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="CameraButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/camera_button</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/camera_button_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
